import os
import sys
import signal
import locale
import gettext

VERSION = '@VERSION@'

# meson bakes pkgdatadir/localedir in as absolute paths from the BUILD
# machine (e.g. D:/a/Kaghez/Kaghez/dist/share/kaghez). That's fine for a
# normal `meson install` deployment that stays put, but PyInstaller and
# Inno Setup both relocate the installed tree onto the end user's
# machine, where the build-time path doesn't exist. So on Windows we
# recompute these relative to wherever the frozen exe actually landed.
if getattr(sys, 'frozen', False):
    # Running as a PyInstaller-frozen executable. PyInstaller 6.x puts
    # bundled `datas` under an _internal/ folder next to the exe rather
    # than flat alongside it -- confirmed via CI debug output showing
    # the gresource lands at <exe_dir>/_internal/share/kaghez/.
    exe_dir = os.path.dirname(sys.executable)
    base_dir = os.path.join(exe_dir, '_internal')
    pkgdatadir = os.path.join(base_dir, 'share', 'kaghez')
    localedir = os.path.join(base_dir, 'share', 'locale')

    # build-aux/windows/build.sh compiles our GSettings schema into its
    # own folder so it can't clash with GTK's bundled schemas. GLib
    # searches every directory listed here, so prepend ours.
    schema_dirs = [os.path.join(pkgdatadir, 'schemas')]
    if os.environ.get('GSETTINGS_SCHEMA_DIR'):
        schema_dirs.append(os.environ['GSETTINGS_SCHEMA_DIR'])
    os.environ['GSETTINGS_SCHEMA_DIR'] = os.pathsep.join(schema_dirs)

    # The windowed exe has no console, so print() would go nowhere. Keep
    # the output (including the Suwayomi server's) in a log file instead.
    if sys.stdout is None:
        log_dir = os.path.join(os.environ.get('LOCALAPPDATA', exe_dir), 'kaghez')
        os.makedirs(log_dir, exist_ok=True)
        log_file = open(os.path.join(log_dir, 'kaghez.log'), 'w',
                        encoding='utf-8', errors='replace', buffering=1)
        sys.stdout = sys.stderr = log_file

    # NOTE: previously set GI_TYPELIB_PATH manually here pointing at a
    # copied girepository-1.0 folder. Removed to test whether
    # PyInstaller's `gi` hook (hooksconfig in kaghez.spec) resolves
    # typelibs on its own, the way it does in Varia's working build --
    # Varia's workflow never sets this env var or copies typelibs
    # manually. If "Namespace Gtk not available" comes back, this is
    # the fix to reinstate:
    #   os.environ['GI_TYPELIB_PATH'] = os.path.join(exe_dir, 'girepository-1.0')
    # (and build.yml's DLL-bundling step needs the matching cp -r
    # girepository-1.0 line added back too).
else:
    # Normal `meson install` deployment (Linux/Flatpak): trust the
    # paths meson baked in at build time.
    pkgdatadir = '@pkgdatadir@'
    localedir = '@localedir@'

sys.path.insert(1, pkgdatadir)
signal.signal(signal.SIGINT, signal.SIG_DFL)

# locale.bindtextdomain/textdomain don't exist on Windows Python builds
# (they're POSIX-only, backed by libintl on Linux/macOS), so guard them
# the same way Varia does rather than crashing on startup.
try:
    locale.bindtextdomain('kaghez', localedir)
    locale.textdomain('kaghez')
except AttributeError:
    print('Cannot set locale.')

try:
    gettext.bindtextdomain('kaghez', localedir)
    gettext.textdomain('kaghez')
except AttributeError:
    print('Cannot load translations.')

if __name__ == '__main__':
    import gi

    from gi.repository import Gio
    resource = Gio.Resource.load(os.path.join(pkgdatadir, 'kaghez.gresource'))
    resource._register()

    from kaghez import main
    sys.exit(main.main(VERSION))
